rules_version = '2';

// Reviews on the games list (reviews.js). Paste this into Firebase:
// Firestore Database > Rules > Publish.
//   - everyone can read them
//   - you can add one (as yourself, with a short name and text)
//   - you can only delete your own
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['idea', 'comment']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
